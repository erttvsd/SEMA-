# ===== نظام «سِيمَا الخَيْر» — متغيرات البيئة =====
# انسخ هذا الملف إلى .env وعبّئ القيم. لا تضع .env في المستودع.

# --- إلزامية في الإنتاج ---
NODE_ENV=production
# سرّ توقيع الجلسات: 48 حرفاً عشوائياً على الأقل — مثلاً: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SEMA_JWT_SECRET=
# العنوان العام للموقع — تُبنى منه روابط رموز QR والبريد
SEMA_PUBLIC_URL=https://sema.ly
# إخفاء الحسابات التصويرية من صفحة الدخول
SEMA_DEMO=0

# مفتاح تشفير مفاتيح التحقق بخطوتين في القاعدة — مستحسن، ولا يُغيَّر بعد التشغيل
SEMA_DATA_KEY=

# --- البريد ---
# smtps://user:password@smtp.example.ly:465   (أو smtp://…:587 مع STARTTLS)
SEMA_SMTP_URL=

# --- الشبكة ---
# عدد الوكلاء العكسيين الموثوقين أمام الخادم (1 خلف nginx) — لازم لقراءة عنوان العميل الحقيقي في حدود المحاولات
SEMA_TRUST_PROXY=1
PORT=3000

# --- التشغيل ---
# مجلد البيانات (قاعدة البيانات + uploads + backups)
SEMA_DATA_DIR=/data
# مجلد النسخ الاحتياطية إن أردته على قرص آخر
# SEMA_BACKUP_DIR=/backups
# دورة المهام الآلية بالساعات (الافتراضي 6) — و 0 في SEMA_JOBS يعطّلها
SEMA_JOBS_HOURS=6
# حد التسجيل الذاتي لكل عنوان في الساعة
SEMA_REG_LIMIT=10
