{
  "name": "sema-alkhayr",
  "version": "1.0.0",
  "private": true,
  "description": "نظام إدارة علامة «سِيمَا الخَيْر» — العلامة الوطنية الليبية للمساهمة في الأعمال الخيرية والإنسانية والتنموية",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed-run.js",
    "test": "node tests/run.js",
    "docs": "node scripts/gen-docs.js",
    "reset": "rm -rf storage && npm run seed",
    "test:unit": "node tests/run.js --only=unit",
    "init": "node scripts/init.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test:mcp": "npm --prefix tools/dokploy-mcp test",
    "deploy:dokploy": "node tools/dokploy-mcp/deploy-sema.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
